[
  { "Name": "standard block", "Text": "name: demo\ndependencies:\n  flutter:\n    sdk: flutter\n", "Expected": true },
  { "Name": "quoted atoms", "Text": "'dependencies':\n  \"flutter\":\n    'sdk': \"flutter\" # sdk\n", "Expected": true },
  { "Name": "inline SDK", "Text": "dependencies:\n  flutter: {sdk: flutter}\n  http: any\n", "Expected": true },
  { "Name": "inline dependencies", "Text": "dependencies: {flutter: {sdk: flutter}, http: any}\n", "Expected": true },
  { "Name": "unrelated dependencies", "Text": "dependencies:\n  http: any\n  flutter:\n    sdk: flutter\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n", "Expected": true },
  { "Name": "comments only", "Text": "# dependencies:\n#   flutter:\n#     sdk: flutter\n", "Expected": false },
  { "Name": "description text", "Text": "description: 'dependencies: flutter sdk: flutter'\n", "Expected": false },
  { "Name": "dev SDK only", "Text": "dev_dependencies:\n  flutter_test:\n    sdk: flutter\n", "Expected": false },
  { "Name": "test dependency only", "Text": "dependencies:\n  flutter_test:\n    sdk: flutter\n", "Expected": false },
  { "Name": "Dart project", "Text": "dependencies:\n  http: any\n", "Expected": false },
  { "Name": "wrong SDK", "Text": "dependencies:\n  flutter:\n    sdk: dart\n", "Expected": false },
  { "Name": "wrong SDK case", "Text": "dependencies:\n  flutter:\n    sdk: Flutter\n", "Expected": false },
  { "Name": "case sensitive dependency", "Text": "Dependencies:\n  flutter:\n    sdk: flutter\n", "Expected": false },
  { "Name": "nested fake flutter", "Text": "dependencies:\n  another:\n    flutter:\n      sdk: flutter\n", "Expected": false },
  { "Name": "nested fake SDK", "Text": "dependencies:\n  flutter:\n    extra:\n      sdk: flutter\n", "Expected": false },
  { "Name": "duplicate roots", "Text": "dependencies:\n  flutter:\n    sdk: flutter\ndependencies: {}\n", "Expected": false },
  { "Name": "duplicate dependency", "Text": "dependencies:\n  flutter:\n    sdk: flutter\n  flutter: any\n", "Expected": false },
  { "Name": "duplicate SDK", "Text": "dependencies:\n  flutter:\n    sdk: flutter\n    sdk: dart\n", "Expected": false },
  { "Name": "tab indentation", "Text": "dependencies:\n\tflutter:\n\t\tsdk: flutter\n", "Expected": false },
  { "Name": "alias unsupported", "Text": "dependencies:\n  flutter: *sdk\n", "Expected": false },
  { "Name": "empty", "Text": "", "Expected": false },
  { "Name": "UTF8 BOM", "Text": "﻿dependencies:\n  flutter:\n    sdk: flutter\n", "Expected": true },
  { "Name": "document boundary", "Text": "name: dart_only\n---\ndependencies:\n  flutter:\n    sdk: flutter\n", "Expected": false },
  { "Name": "document end", "Text": "dependencies:\n  flutter:\n    sdk: flutter\n...\n", "Expected": false },
  { "Name": "NUL even inside comment", "Text": "dependencies:\n  flutter:\n    sdk: flutter\n# bad\u0000trailer", "Expected": false },
  { "Name": "non mapping at lower indent", "Text": "dependencies:\n    flutter:\n      sdk: flutter\n  this is plain scalar text\n", "Expected": false },
  { "Name": "empty flow entry", "Text": "dependencies: {flutter: {sdk: flutter}, ,}\n", "Expected": false },
  { "Name": "single trailing comma", "Text": "dependencies: {flutter: {sdk: flutter},}\n", "Expected": true }
]
